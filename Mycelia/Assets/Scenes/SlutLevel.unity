  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: King Shroom
        icon: {fileID: 1098335133381290355, guid: f45cbbae3112f0a4aa1f73ee09eb135d, type: 3}
      line: Oh dear Winged One...
    - character:
        name: King Shroom
        icon: {fileID: -1976452005871167202, guid: f45cbbae3112f0a4aa1f73ee09eb135d, type: 3}
      line: Thank you for freeing me. I feared all was lost... But here you are.
    - character:
        name: King Shroom
        icon: {fileID: -1976452005871167202, guid: f45cbbae3112f0a4aa1f73ee09eb135d, type: 3}
      line: The Saviour of Mycelia. The Purger of the Agarics...
    - character:
        name: King Shroom
        icon: {fileID: -1976452005871167202, guid: f45cbbae3112f0a4aa1f73ee09eb135d, type: 3}
      line: The Slayer of Evil
    - character:
        name: King Shroom
        icon: {fileID: -1976452005871167202, guid: f45cbbae3112f0a4aa1f73ee09eb135d, type: 3}
      line: I bestow upon thee the highest honor i can. Thank you.
    automaticAdvance: 0
    autoAdvanceDelay: 1.5
  ableToWalkDuringDialogue: 0
