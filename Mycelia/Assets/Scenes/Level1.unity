  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 57603701dd0147e43b5295c375e99a88, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: Elder Cap
        icon: {fileID: 8238638941979423301, guid: 6ead8f8e694501b4eb48a851baedab56, type: 3}
      line: "Woah Faye hold on wait!\t"
    - character:
        name: Elder Cap
        icon: {fileID: 8238638941979423301, guid: 6ead8f8e694501b4eb48a851baedab56, type: 3}
      line: Those darn Agarics set up a trap
    - character:
        name: Elder Cap
        icon: {fileID: 8238638941979423301, guid: 6ead8f8e694501b4eb48a851baedab56, type: 3}
      line: You have to move carefully and time your jump when the platform is long
        enough
    - character:
        name: Elder Cap
        icon: {fileID: 8238638941979423301, guid: 6ead8f8e694501b4eb48a851baedab56, type: 3}
      line: Be careful not to fall in!
    - character:
        name: Elder Cap
        icon: {fileID: 8238638941979423301, guid: 6ead8f8e694501b4eb48a851baedab56, type: 3}
      line: Oh and before i forget, these dang Agarics probably put more traps out
        in Mycelia so keep an eye out for them.
    automaticAdvance: 0
    autoAdvanceDelay: 1.5
  ableToWalkDuringDialogue: 1
