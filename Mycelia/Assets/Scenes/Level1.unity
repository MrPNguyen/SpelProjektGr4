MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1995364975}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 57603701dd0147e43b5295c375e99a88, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: Elder Cap
        icon: {fileID: 8238638941979423301, guid: 6ead8f8e694501b4eb48a851baedab56, type: 3}
      line: Dear Faye look! one of Mycelias magical mushrooms.
    - character:
        name: Elder Cap
        icon: {fileID: 8238638941979423301, guid: 6ead8f8e694501b4eb48a851baedab56, type: 3}
      line: This one is called a meadowshroom, its known for its bouncyness.
    - character:
        name: Elder Cap
        icon: {fileID: 8238638941979423301, guid: 6ead8f8e694501b4eb48a851baedab56, type: 3}
      line: However even if they are bouncy they are still to stiff to jump on normally,
    - character:
        name: Elder Cap
        icon: {fileID: 8238638941979423301, guid: 6ead8f8e694501b4eb48a851baedab56, type: 3}
      line: so you'll need to apply a little extra force to get a good bounce, try
        harddropping on them like you did the Agarics!
    automaticAdvance: 0
    autoAdvanceDelay: 1.5
  ableToWalkDuringDialogue: 1
