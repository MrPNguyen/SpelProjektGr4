  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: Elder Cap
        icon: {fileID: 8238638941979423301, guid: 6ead8f8e694501b4eb48a851baedab56, type: 3}
      line: Faye! Faye! Wait a minute watch out!
    - character:
        name: Elder Cap
        icon: {fileID: 8238638941979423301, guid: 6ead8f8e694501b4eb48a851baedab56, type: 3}
      line: You can't go into the water. Those damn Agarics poisoned all our water
        supply with their foul odor.
    - character:
        name: Elder Cap
        icon: {fileID: 8238638941979423301, guid: 6ead8f8e694501b4eb48a851baedab56, type: 3}
      line: One touch is all that is needed to perish so tread carefully and make
        sure not to fall in.
    automaticAdvance: 0
    autoAdvanceDelay: 1.5
  ableToWalkDuringDialogue: 1
